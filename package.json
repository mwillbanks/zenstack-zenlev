{
  "name": "@mwillbanks/zenstack-zenlev",
  "version": "0.2.0",
  "description": "A Bun-native migration system for ZenStack V3 with a reusable Kysely migration engine.",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "license": "MIT",
  "author": "Mike Willbanks",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwillbanks/zenstack-zenlev.git"
  },
  "homepage": "https://mwillbanks.github.io/zenstack-zenlev/",
  "bugs": {
    "url": "https://github.com/mwillbanks/zenstack-zenlev/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "bin": {
    "zenstack-zenlev": "./dist/cli.js",
    "zenlev": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "logo.svg",
    "LICENSE"
  ],
  "scripts": {
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "verify": "bun run format:check && bun check && bun run lint && bun test --bail",
    "verify:coverage": "bun run format:check && bun check && bun run lint && bun run test:coverage",
    "lint": "oxlint src test scripts && bun scripts/check-unit-timing.ts",
    "test": "bun test --bail",
    "test:coverage": "bun test --coverage --bail --coverage-reporter=text --coverage-reporter=lcov && bun scripts/check-coverage.ts",
    "skills:prepare": "bun scripts/skills.ts",
    "skills:check": "bun run skills:prepare && intent validate --check",
    "skills:review": "bun scripts/skills.ts review",
    "build": "bun run skills:prepare && bun scripts/build.ts",
    "pack:check": "bun scripts/pack-check.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@mwillbanks/tuil": "1.0.3",
    "@mwillbanks/tuil-cell": "1.0.3",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@paralleldrive/cuid2": "3.3.0",
    "@zenstackhq/language": "3.10.3",
    "react": "19.3.1"
  },
  "peerDependencies": {
    "@zenstackhq/orm": ">=3.10.0 <4",
    "kysely": ">=0.29.0 <0.30.0"
  },
  "peerDependenciesMeta": {
    "@zenstackhq/orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/intent": "0.5.6",
    "@types/bun": "1.4.5",
    "@types/pg": "8.23.1",
    "@zenstackhq/orm": "3.10.3",
    "@zenstackhq/schema": "3.10.3",
    "kysely": "0.29.9",
    "mysql2": "3.24.6",
    "oxc-parser": "0.160.0",
    "oxlint": "1.95.0",
    "pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.15.0"
  },
  "keywords": [
    "bun",
    "database",
    "kysely",
    "migrations",
    "tanstack-intent",
    "zenstack",
    "zenstack-v3"
  ]
}
